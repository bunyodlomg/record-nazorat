# JWT — yangi serverda ALBATTA o'zgartiring (uzun random string):
#   openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# Frontend domain — CORS va Telegram WebApp uchun
CLIENT_URL=https://recordspeaking.uz
CORS_ORIGINS=https://recordspeaking.uz

# Telegram bot
BOT_TOKEN=8330232872:AAGMCMznBhgXy1b-Qq-0ywHE1l5mwW2ycFI
BOT_USERNAME=Record_Nazorat_Bot
TELEGRAM_ADMIN_ID=1864986540
TELEGRAM_INITDATA_TTL=86400

# WebApp URL — bot xabarlaridagi tugma uchun (production domain)
WEBAPP_URL=https://recordspeaking.uz

# Reminder loop (vazifa tekshirish kechikishi)
